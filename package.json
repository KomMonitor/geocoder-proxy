{
  "name": "kommonitor-geocoder-proxy",
  "version": "1.0.5",
  "description": "KomMonitor Geocoder Proxy defining a common query and response interface for geocoding services (nominatim, photon  with datasource OSM)",
  "main": "index.js",
  "scripts": {
    "prestart": "npm install",
    "start": "node index.js",
    "release": "release-it"
  },
  "keywords": [
    "kommonitor",
    "geocoder"
  ],
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "body-parser": "^1.20.9",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "oas3-tools": "^2.2.3"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "jshint": "^2.13.6",
    "license-checker-rseidelsohn": "^5.0.1",
    "release-it": "^21.1.2"
  },
  "overrides": {
    "oas3-tools": {
      "body-parser": "$body-parser",
      "express-openapi-validator": "^5.6.2",
      "multer": "^2.5.0"
    },
    "jshint": {
      "minimatch": "^3.1.5"
    },
    "license-checker-rseidelsohn": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "basic-ftp": "^6.2.6",
    "lodash": "^4.18.1",
    "qs": "^6.17.1"
  },
  "jshintConfig": {
    "undef": true,
    "unused": true,
    "esversion": 8
  }
}
